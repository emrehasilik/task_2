# Copy this template to .env.local. Never commit real secrets.
AUTH_API_URL=http://localhost:5001
PRODUCT_API_URL=http://localhost:5002
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated HTTPS image hosts accepted by next/image.
NEXT_PUBLIC_IMAGE_HOSTS=images.unsplash.com,images.pexels.com,cdn.pixabay.com
# Server-only Supabase Storage configuration. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_side_key
SUPABASE_PRODUCT_IMAGES_BUCKET=product-images

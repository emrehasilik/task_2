# Both APIs use the same Supabase PostgreSQL database. Prefer the Session Pooler
# value shown by Supabase under Project > Connect for a local IPv4 environment.
ConnectionStrings__MarketplaceDatabase=Host=aws-0-REGION.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.PROJECT_REF;Password=SUPABASE_DATABASE_PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=20;Connection Idle Lifetime=300;Timeout=15;Command Timeout=30;Keepalive=30

# Auth and Product APIs must use exactly the same signing key.
Jwt__SigningKey=replace-with-at-least-32-random-characters-for-development

# Redis remains a task requirement. Keep its password in the deployment secret store.
Redis__Endpoint=YOUR_REDIS_ENDPOINT
Redis__Port=6379
Redis__User=default
Redis__Password=YOUR_REDIS_PASSWORD
Redis__UseSsl=true

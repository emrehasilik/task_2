{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MarketplaceDatabase": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Redis": {
    "Endpoint": "localhost",
    "Port": 6379,
    "User": "default",
    "Password": "",
    "UseSsl": false,
    "InstanceName": "localcart"
  },
  "Jwt": {
    "Issuer": "LocalCart.Auth",
    "Audience": "LocalCart.Clients",
    "SigningKey": ""
  },
  "Cors": {
    "Origins": ["http://localhost:3000"]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName"]
  }
}
